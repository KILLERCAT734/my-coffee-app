import Link from 'next/link';
import { notFound } from 'next/navigation';
import { dishes, getDishById } from '@/lib/dishes';
import { ArrowLeft, Coffee } from 'lucide-react';

export function generateStaticParams() {
  return dishes.map((dish) => ({ id: String(dish.id) }));
}

export default async function DishPage({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;
  const dish = getDishById(Number(id));

  if (!dish) {
    notFound();
  }

  return (
    <div className="container mx-auto px-6 py-16">
      <Link
        href="/menu"
        className="inline-flex items-center gap-2 text-slate-600 hover:text-[#EF7F04] mb-8 transition-colors"
      >
        <ArrowLeft className="w-4 h-4" />
        Назад в меню
      </Link>

      <div className="grid md:grid-cols-2 gap-12 items-start">
        <div className="aspect-square bg-amber-100 rounded-lg overflow-hidden">
          <img
            src={dish.image}
            alt={dish.name}
            className="w-full h-full object-cover"
          />
        </div>

        <div>
          <h1 className="text-4xl font-bold text-slate-800 mb-4">{dish.name}</h1>
          <p className="text-3xl font-bold text-[#EF7F04] mb-6">{dish.price} ₽</p>
          <p className="text-lg text-slate-600 leading-relaxed mb-8">
            {dish.description}
          </p>

          <Link
            href="/menu"
            className="inline-flex items-center gap-2 bg-[#EF7F04] hover:bg-[#d66f03] text-white px-6 py-3 rounded font-medium transition-colors"
          >
            <Coffee className="w-5 h-5" />
            Назад в меню
          </Link>
        </div>
      </div>
    </div>
  );
}